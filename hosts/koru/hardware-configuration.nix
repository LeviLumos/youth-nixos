# hardware-configuration.nix —— nixos-generate-config 自动生成的硬件配置：
# 记录本机磁盘/文件系统布局、initrd 所需内核模块与 CPU 微码更新策略。
# 由 flake.nix 的 mkHost 以目录 ./hosts/koru 导入，经 default.nix 汇总生效。
# 维护约定：设备/UUID/子卷等生成真值保持不动；挂载性能参数集中在
#   btrfs-mounts.nix 追加覆盖，引导模块取舍在 boot.nix。
# Do not modify this file!  It was generated by ‘nixos-generate-config’
# and may be overwritten by future invocations.  Please make changes
# to /etc/nixos/configuration.nix instead.
{
  config,
  lib,
  modulesPath,
  ...
}:

{
  imports = [
    (modulesPath + "/installer/scan/not-detected.nix")  # 声明这是真实硬件而非安装镜像目标，跳过安装器专用探测
  ];

  # initrd 早期阶段必需的驱动：USB3 控制器、NVMe 盘、USB 键鼠/外置存储与 SCSI 磁盘层
  boot.initrd.availableKernelModules = [
    "xhci_pci"
    "nvme"
    "usbhid"
    "usb_storage"
    "sd_mod"
  ];
  boot.initrd.kernelModules = [ ];
  boot.kernelModules = [ "kvm-intel" ];  # 加载 Intel VT-x 模块供 KVM 虚拟化使用
  boot.extraModulePackages = [ ];

  # btrfs 单盘多子卷布局：三处挂载同一 UUID，仅子卷不同
  fileSystems."/" = {
    device = "/dev/disk/by-uuid/48243d82-a8d4-497e-a85d-f8dcabd996fc";  # 根子卷（默认子卷）
    fsType = "btrfs";
  };

  fileSystems."/home" = {
    device = "/dev/disk/by-uuid/48243d82-a8d4-497e-a85d-f8dcabd996fc";
    fsType = "btrfs";
    options = [ "subvol=home" ];  # /home 子卷
  };

  fileSystems."/nix" = {
    device = "/dev/disk/by-uuid/48243d82-a8d4-497e-a85d-f8dcabd996fc";
    fsType = "btrfs";
    options = [ "subvol=nix" ];  # /nix 子卷
  };

  fileSystems."/boot" = {
    device = "/dev/disk/by-uuid/F298-39EF";
    fsType = "vfat";
    options = [
      "fmask=0077"  # 目录权限 0077
      "dmask=0077"  # 文件权限 0077（两项合计：EFI 分区仅 root 可读写，防普通用户篡改引导文件）
    ];
  };

  swapDevices = [ ];  # 无交换分区；压缩交换由 system/memory-zram.nix 提供

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";  # 固定构建目标架构
  hardware.cpu.intel.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;  # 启动时随可再分发固件一起更新 Intel CPU 微码
}
