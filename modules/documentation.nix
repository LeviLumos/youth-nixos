# ============================================================================
# modules/documentation.nix —— 系统文档与手册
# ----------------------------------------------------------------------------
# 作用：安装 man 手册及其数据库，并在系统内提供 NixOS 选项查询工具。
#
# 常用命令：
#   man nixos.conf        查看 NixOS 配置项手册
#   man <命令名>           查看任意命令的使用说明
#   nixos-option <选项>    查询某个 NixOS 选项的定义与默认值
# ============================================================================

# pkgs 用于引用 man-pages 系列包；... 表示接受其它未声明的模块参数
{pkgs, ...}: {
  # --------------------------------------------------------------------------
  # 直接安装的手册包
  # --------------------------------------------------------------------------
  environment.systemPackages = with pkgs; [
    man-pages # GNU/Linux 核心命令手册
    man-pages-posix # POSIX 标准命令手册
  ];

  # --------------------------------------------------------------------------
  # 文档子系统
  # 说明：documentation.man 即上面这些手册包的总开关；
  #       documentation.enable 则会额外启用 nixos-help 等 NixOS 专属文档工具。
  # --------------------------------------------------------------------------
  documentation = {
    enable = true;
    man = {
      enable = true;
      # 生成并缓存手册页，避免每次渲染都需要重新经过 groff，提高查询速度
      cache.enable = true;
      man-db = {
        enable = true; # mandb 数据库：支持 apropos / man -k 关键词搜索
      };
    };
  };
}