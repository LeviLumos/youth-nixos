# ============================================================================
# modules/clash.nix —— 网络代理配置
# ----------------------------------------------------------------------------
# 作用：
#   1. 启用 Clash Verge 图形客户端（基于 mihomo 内核），开机自启；
#   2. 开启 TUN 模式与系统代理接管，无需为每个应用单独设置环境变量；
#   3. 为系统级会话提供 http_proxy / https_proxy 等环境变量，
#      供 curl、Git 等命令行工具使用。
#
# 参数说明：
#   autoStart   —— 登录桌面后自动启动代理客户端
#   tunMode     —— TUN 虚拟网卡模式：可接管不遵循 http_proxy 约定的程序
#   serviceMode —— 安装为 systemd 服务（是否可用取决于该包版本）
#
# 端口 7897 为 Clash Verge 默认的混合代理端口（同时处理 HTTP/SOCKS）。
# 若在客户端中修改了端口，需同步修改下方三处地址。
# ============================================================================

# 形参使用 `_` 表示不需要任何 NixOS 模块参数（例如 pkgs）
_: {
  programs.clash-verge = {
    enable = true;
    # package = pkgs-unstable.clash-verge-rev; # 如需改用 unstable 版本可取消注释
    autoStart = true; # 随桌面会话自动启动
    tunMode = true; # 开启 TUN 模式，全局接管流量
    serviceMode = true; # 以系统服务方式运行（开机即生效，早于桌面启动）
  };

  # --------------------------------------------------------------------------
  # 系统级代理设置
  # 说明：这些变量写入 /etc/profile 与 systemd 用户环境；
  #       图形程序通常不读取它们，因此依赖 TUN 模式兜底。
  # --------------------------------------------------------------------------
  networking.proxy = {
    default = "http://127.0.0.1:7897"; # 未分类请求的默认代理
    httpProxy = "http://127.0.0.1:7897"; # HTTP 代理
    httpsProxy = "http://127.0.0.1:7897"; # HTTPS 代理
    noProxy = "localhost,127.0.0.1,::1,*.local"; # 本地地址与 mDNS 直连，避免回环死锁
  };
}