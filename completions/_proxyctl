#compdef proxyctl
# _proxyctl —— proxyctl 的 Zsh 补全（compdef 框架）：--color 与六个子命令补全。
# 节点名为动态补全：读 proxyctl 缓存快照的 nodes.json（jq 以 NUL 分隔读出
#   name 与“延迟 ms cached”描述），无缓存时提示先运行 proxyctl refresh。
# 安装：system/mihomo.nix 放入系统级 zsh site-functions。

# 动态补全缓存节点名：优先读 current 快照的 nodes.json，否则回退默认路径；
# 用 jq 以 NUL 分隔读出 name 与描述，供 compadd 显示；
# 无缓存时提示先运行 proxyctl refresh
_proxyctl_nodes() {
  local cache=${PROXYCTL_NODES_FILE:-$HOME/.config/mihomo/nodes.json}
  [[ ! -r $HOME/.config/mihomo/cache/current/nodes.json ]] || cache=$HOME/.config/mihomo/cache/current/nodes.json
  local name description
  local -a names descriptions
  if [[ -r $cache ]] && (( $+commands[jq] )); then
    while IFS= read -r -d $'\0' name && IFS= read -r -d $'\0' description; do
      names+=("$name")
      descriptions+=("$description")
    done < <(jq -j '.[] | .name, "\u0000", ((.latency_ms | tostring) + " ms cached"), "\u0000"' -- "$cache" 2>/dev/null)
    _wanted nodes expl 'cached proxy node' compadd -Q -d descriptions -- "${names[@]}"
  else
    _message 'no local node cache; run proxyctl refresh'
  fi
}

_proxyctl() {
  local context state line
  typeset -A opt_args
  local -a commands
  # 子命令与一句话描述
  commands=(
    'start:start the proxy using a cached node'
    'status:show local service, controller and cache state'
    'shutdown:stop the proxy and TUN interface'
    'refresh:fetch, parse and probe the subscription'
    'nodes:list locally cached usable nodes'
    'help:show command help'
  )

  _arguments -C \
    '(- 1 *)'{-h,--help}'[show help]' \
    '--color=[color policy]:policy:(auto always never)' \
    '1:command:->command' \
    '*::argument:->arguments'

  case $state in
    command)
      _describe -t commands command commands
      ;;
    # start 补 --node（动态节点列表）；status 补 --json 与三种测量；
    # refresh 补 --restore；shutdown/nodes/help 无参数
    arguments)
      case $line[1] in
        start)
          _arguments '--node=[use an exact cached node name]:node:_proxyctl_nodes'
          ;;
        status)
          _arguments \
            '--json[emit parseable JSON]' \
            '--latency[probe current-node HTTP latency]' \
            '--traffic[sample existing proxy traffic]' \
            '--speed-test[run a bounded download goodput test]'
          ;;
        refresh)
          _arguments '--restore[restore the prior service and node after refresh]'
          ;;
        shutdown|nodes|help)
          _arguments
          ;;
      esac
      ;;
  esac
}

_proxyctl "$@"
