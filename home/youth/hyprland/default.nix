# ============================================================================
# home/youth/hyprland/default.nix —— Hyprland 桌面环境子模块入口
# ----------------------------------------------------------------------------
# Hyprland 是一个基于 wlroots 的动态效果型 Wayland 合成器，
# 以动画流畅、配置灵活（支持 Lua 脚本）著称。
# 系统级开关（programs.hyprland、withUWSM、XWayland）位于 configuration.nix，
# 本目录只负责用户级配置与配套组件。
#
# 目录结构：
#   hypr/hyprland.lua   —— 主配置（Lua 脚本形式，支持热重载与逻辑判断）
#   scripts/            —— 截图/录屏/壁纸切换等辅助脚本
#   waybar/             —— 状态栏（配置 + 样式 + 脚本）
#   wlogout/            —— 关机/重启/注销/锁屏选择界面
#   hyprlock/           —— 锁屏程序及其主题
#
# 注意：本机同时安装了 Niri（见 ../niri），在 GDM 登录界面可自由切换。
# ============================================================================
# 模块参数：pkgs —— 包集合；... —— 接受其它未声明的参数
{pkgs, ...}: {
  # ------------------------------------------------------------------------
  # 子模块
  # ------------------------------------------------------------------------
  imports = [
    ./scripts # 截图/录屏/壁纸等辅助脚本的安装
    ./waybar/waybar.nix # 状态栏
    ./wlogout/wlogout.nix # 电源菜单
    ./hyprlock/hyprlock.nix # 锁屏
  ];

  # ------------------------------------------------------------------------
  # Hyprland 主体
  # 说明：系统级 enable 在 configuration.nix 中已开启，此处只保证用户
  #       侧也安装了一份（配置于 uwsmsession 下时使用）。
  # ------------------------------------------------------------------------
  home.packages = with pkgs; [
    hyprland # Hyprland 合成器
  ];

  # ------------------------------------------------------------------------
  # 主配置
  # 说明：把本目录下的 hypr/ 整个文件夹递归链接到 ~/.config/hypr/，
  #       其中 hyprland.lua 由 Hyprland 自动识别为入口配置。
  #   注意路径写法：home.file 的键以「/」开头时会被当作相对 home 目录的路径。
  # ------------------------------------------------------------------------
  home.file.".config/hypr" = {
    source = ./hypr; # 配置目录来源（本仓库的 hypr/ 子目录）
    recursive = true; # 递归复制/链接整个目录树
  };

  # ------------------------------------------------------------------------
  # polkit 认证代理
  # 说明：系统级已在 configuration.nix 中启用 services.polkit-gnome，
  #       因此 Hyprland 专用的 hyprpolkitagent 无需重复启用。
  # ------------------------------------------------------------------------
  # services.hyprpolkitagent.enable = true;
  # services.hyprpolkitagent.package = pkgs.hyprpolkitagent;
}
