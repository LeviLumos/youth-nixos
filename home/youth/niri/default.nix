# ============================================================================
# home/youth/niri/default.nix —— Niri 桌面环境配置
# ----------------------------------------------------------------------------
# Niri 是一个滚动式平铺（scrolling tiling）Wayland 合成器，
# 窗口沿一个方向无限延伸，垂直空间永远被充分利用，适合大屏与代码工作流。
#
# 本机同时安装了 Hyprland（见 ../hyprland），在 GDM 登录界面可自由切换，
# 两套环境共用同一套应用、输入法与壁纸配置。
#
# Niri 官方不提供应用启动器，因此本文件额外安装了 fuzzel 作为启动器。
#
# 依赖关系：
#   fuzzel（启动器）与 Noctalia（桌面 Shell）配合使用
#   config.kdl 中的 keybindings 需要与 fuzzel / noctalia 命令名一致
# ============================================================================
# 形参使用 `_` 表示不需要任何 home-manager 模块参数
_: {
  # ------------------------------------------------------------------------
  # fuzzel：轻量级应用启动器（替代 rofi 在 Niri 环境中的角色）
  # ------------------------------------------------------------------------
  programs.fuzzel.enable = true;

  catppuccin.fuzzel = {
    enable = true; # 应用 Catppuccin 配色
    accent = "mauve"; # 强调色（高亮与边框）
    flavor = "mocha"; # 深色主题
  };

  # ------------------------------------------------------------------------
  # Niri 主配置
  # 说明：Niri 使用 KDL（Khipu Document Language）格式的配置文件，
  #       非 INI/TOML。安装位置 ~/.config/niri/config.kdl。
  # ------------------------------------------------------------------------
  home.file.".config/niri/config.kdl".source = ./config.kdl;
}
