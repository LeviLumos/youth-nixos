/* ============================================================================
 * screenshot.rasi —— rofi 截图/录屏菜单主题
 * ----------------------------------------------------------------------------
 * 安装位置：~/.config/rofi/themes/screenshot.rasi（由 ../rofi.nix 分发）
 * 使用者：截图录屏脚本 capture.sh（路径 ~/.config/hypr/scripts/capture.sh）
 *          脚本中通过 ROFI_THEME 环境变量指定本主题，并使用
 *          `rofi -dmenu` 以「管道传入选项」的纯列表模式调用。
 *
 * 与 app.rasi 的区别：
 *   本主题没有输入栏（无 prompt / entry），只显示由脚本传入的选项，
 *   例如「全屏截图 / 区域截图 / 全屏录屏 / 区域录屏 / 取消」。
 *
 * 视觉风格：与 app.rasi 一致的柔和粉紫基调，选项为居中大按钮。
 * ========================================================================== */

/* ---- 全局配色变量 ---- */
* {
    /* 柔和粉紫基调 */
    base-bg: rgba(30, 30, 46, 0.85);   // 窗口背景：半透明深紫
    selected-bg: #6c7086;                 // 选中项背景

    background-color: transparent;       // 默认背景透明
    text-color: #cdd6f4;                 // 默认文字色
}

/* ---- 窗口本体：窄一些、居中 ---- */
window {
    width: 25%;                  // 宽度为屏幕 25%（纯文字选项，无需更宽）
    // height: 45%;              // 不固定高度，随选项数量自适应
    border: 2px;                 // 边框宽度
    border-radius: 1.2em;        // 圆角
    border-color: #f4b8e4;   /* #F4B8E4 */  // 边框：淡粉色
    location: center;            // 窗口居中
    children: [ listbox ];       // 直接以列表为唯一内容
    background-color: @base-bg;
}

/* ---- 列表外框：提供内边距与居中 ---- */
listbox {
    padding: 0.5em 0em;          // 上下内边距
    vertical-align: 0.5;         // 垂直居中
    horizontal-align: 0.5;       // 水平居中
    children: [ listview ];
}

/* ---- 选项列表 ---- */
listview {
    padding: 0.6em;              // 列表内边距
    spacing: 0.7em;              // 选项之间的间距
    fixed-height: false;  /* 不固定行数 */  // 高度随选项数量变化
    dynamic: true;               // 支持输入过滤（本主题无输入框，实际不生效）
    // lines: 6;                 // 如需固定行数可取消注释
    columns: 1;                  // 单列显示
    children: [ element ];
}

/* ---- 单个选项按钮 ---- */
element {
    padding: 1em;                // 较大的内边距，形成大按钮观感
    border-radius: 0.8em;        // 圆角
    children: [ element-text ];  // 只显示文字（脚本未传入图标）
}

/* ---- 选项文字 ---- */
element-text {
    font: "mono bold 16";        // 等宽粗体 16 号
    vertical-align: 0.5;         // 垂直居中
    horizontal-align: 0.5;       // 水平居中
}

/* ---- 选中态 ---- */
element selected normal {
    background-color: @selected-bg;
}

