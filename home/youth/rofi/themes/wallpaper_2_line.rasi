 /* ============================================================================
 * wallpaper_2_line.rasi —— rofi 壁纸选择器主题（图文网格）
 * ----------------------------------------------------------------------------
 * 安装位置：~/.config/rofi/themes/wallpaper_2_line.rasi（由 ../rofi.nix 分发）
 * 使用者：壁纸切换脚本 awww-rofi.sh（路径 ~/.config/wallpaper/script/awww-rofi.sh）
 *          脚本以 `rofi -dmenu -show-icons` 调用，并传入
 *          「文件名\0icon\x1f图片绝对路径」格式的数据，
 *          因此每个选项会同时显示图片缩略图与文件名。
 *
 * 布局特点：
 *   大窗口 + 4 列网格，每个格子「上图标下文字」两行式排列。
 *   文件名较长时自动换行显示，因此称为 2_line（两行）。
 *
 * 视觉风格：与其它 rofi 主题一致的柔和粉紫基调。
 * ========================================================================== */

/* ---- 全局配色变量 ---- */
* {
    /* 柔和粉紫基调 */
    base-bg: rgba(30, 30, 46, 0.85);   // 窗口背景：半透明深紫
    selected-bg: #6c7086;                 // 选中项背景

    background-color:transparent;        // 默认背景透明
    border-radius: 1.2em;                 // 通用圆角
    text-color: #cdd6f4;                  // 默认文字色
}

/* ---- 窗口本体：大尺寸、居中 ---- */
window {
    width: 80%;                 // 宽度为屏幕 80%（需容纳多列缩略图）
    height: 60%;                // 高度为屏幕 60%
    border: 2px;                // 边框宽度
    border-radius: 1.2em;       // 圆角
    border-color: #f4b8e4;   /* #F4B8E4 */  // 边框：淡粉色
    location:center;            // 窗口居中
    children:[listbox];         // 唯一内容为列表
    background-color:@base-bg;  // 窗口背景
}

/* ---- 列表外框：垂直排列 ---- */
listbox {
    orientation:vertical;
    children:[listview];
}

/* ---- 网格布局：4 列 ---- */
listview {
    fixed-height: false;  /* 不固定行数 */  // 高度随项目数量自适应
    dynamic: true;               // 支持输入过滤
    columns: 4; // 显示两列（实际为 4 列，注释文字沿用原写法）
    spacing: 1em;                // 网格间距
    children:[element];
}


/* ---- 单个壁纸格子：上图标 + 下文字 ---- */
element {
    children: [element-icon, element-text];  // 先图标后文字，竖排
    orientation:vertical;
    cursor:pointer;    // 鼠标显示为手型
}

/* ---- 文件名文字（过长时自动换行，形成第二行）---- */
element-text {
    vertical-align: 0.5;                     // 垂直居中
    horizontal-align: 0.5;                   // 水平居中
    font:"FiraCode Nerd Font Mono 16";       // Nerd 字体，保证中文与图标正常显示
}

/* ---- 壁纸缩略图 ---- */
element-icon {
    vertical-align: 0.8;                     // 略偏下，与文字保持间距
    horizontal-align: 0.5;                   // 水平居中
    size: 22%;                               // 缩略图尺寸（相对格子宽度）
}

/* ---- 选中态 ---- */
element selected {
    background-color: @selected-bg;
}

