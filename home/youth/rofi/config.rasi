//	me-select-entry: "MousePrimary";
//	me-accept-entry: "MouseDPrimary";
//	me-accept-custom: "Control+MouseDPrimary";
  /* ---- 组合模式（combi）----
   * timeout：切换模式后的输入超时处理
   *   action = "kb-cancel" 超时后执行取消
   *   delay  = 0            0 表示不等待，立即生效
   */
  timeout {
      action: "kb-cancel";
      delay:  0;
  }

  /* ---- filebrowser 模式设置 ----
   * directories-first = true  目录排在文件之前
   * sorting-method = "name"   按名称排序
   */
  filebrowser {
      directories-first: true;
      sorting-method:    "name";
  }
}

// ---- 主题引入 ----
// 说明：@theme 指定外观主题；启动时可用 -theme 参数临时覆盖
//       （例如 Super+D 使用 app.rasi，截图菜单使用 screenshot.rasi）。
// 备选：系统内置主题 "/usr/share/rofi/themes/arthur.rasi"
// @theme "/usr/share/rofi/themes/arthur.rasi"
// @theme "./themes/theme-arg.rasi"
@theme "./themes/custom-theme.rasi"
