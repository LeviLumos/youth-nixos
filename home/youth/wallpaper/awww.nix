# ============================================================================
# home/youth/wallpaper/awww.nix —— 动态壁纸（awww）
# ----------------------------------------------------------------------------
# awww 是一款使用 Rust 编写的动画壁纸工具，底层基于 GPU 加速的 swww，
# 支持多种过渡动画，切换壁纸时有顺滑的视觉效果。
#
# 组件：
#   awww        命令行工具（切换壁纸、设置壁纸等）
#   awww-daemon 后台守护进程，负责实际渲染与动画（必须常驻）
#
# 使用：
#   awww-daemon &                  # 启动守护进程（hyprland.lua 中已配置开机自启）
#   awww img <路径> --transition-type fade
#   awww query                    # 查看当前壁纸
#
# 壁纸目录：
#   本目录下的 image/ 会被安装到 ~/.config/wallpaper/，
#   切换脚本 awww-rofi.sh 默认从该目录扫描图片。
# ============================================================================

# 模块参数：pkgs —— 包集合；... —— 接受其它未声明的参数
{pkgs, ...}: {
  home.packages = with pkgs; [
    awww # 动画壁纸切换工具（含 awww-daemon）
  ];

  # ------------------------------------------------------------------------
  # 安装壁纸目录
  # 说明：source 指向本目录的 image/ 子目录，recursive = true 表示
  #       把其中所有图片（含中文文件名）一并复制/链接过去。
  # ------------------------------------------------------------------------
  home.file.".config/wallpaper" = {
    source = ./image; # 壁纸来源目录
    recursive = true; # 递归安装全部图片
  };
}