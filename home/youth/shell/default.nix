# ============================================================================
# home/youth/shell/default.nix —— Shell 配置子模块入口
# ----------------------------------------------------------------------------
# 由 home/youth/default.nix 的 `imports = [ ./shell ]` 引入。
# Nix 会自动把目录 ./shell 解析为 ./shell/default.nix。
#
# 当前包含：
#   zsh.nix —— 默认 Shell、提示符（starship / powerlevel10k）与常用别名
# ============================================================================
{
  imports = [
    ./zsh.nix # zsh 本体、提示符与别名配置
  ];
}
