# ============================================================================
# home/youth/fcitx5/default.nix —— 输入法子模块入口
# ----------------------------------------------------------------------------
# 本目录配置 Fcitx5 输入法框架，负责中文输入、候选词显示与中英文切换。
#
# 相关环境变量（在 configuration.nix 的 environment.sessionVariables 中声明）：
#   QT_IM_MODULE / QT5_IM_MODULE / XMODIFIERS
#   GTK_IM_MODULE 保持注释：GTK4 原生应用自带输入法支持，强制设置反而
#                         会导致 rofi 等 GTK 程序光标异常。
# ============================================================================
{
  imports = [
    ./fcitx5.nix # Fcitx5 框架、插件与主题
  ];
}
