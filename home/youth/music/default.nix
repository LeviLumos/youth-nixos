_: # ============================================================================
# home/youth/music/default.nix —— 音乐子模块入口
# ----------------------------------------------------------------------------
# 本目录提供两套本地音乐方案，可按需选用或并存：
#   mpd.nix          —— MPD（Music Player Daemon）本地音乐库 + ncmpcpp 前端
#   go-musicfox.nix  —— go-musicfox：网易云音乐类终端客户端
#
# 说明：
#   - MPD 负责实际播放，需把本地音乐文件放入 ~/music 目录；
#   - ncmpcpp 是 MPD 的终端界面，可管理歌单、播放队列；
#   - go-musicfox 直接对接在线音乐服务（需自行配置登录方式）。
# ============================================================================
{
  imports = [
    ./mpd.nix # MPD 音乐守护进程与 ncmpcpp 前端
    ./go-musicfox.nix # 终端音乐播放器 go-musicfox
  ];
}
