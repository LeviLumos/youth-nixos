# ============================================================================
# home/youth/music/go-musicfox.nix —— 终端音乐播放器
# ----------------------------------------------------------------------------
# go-musicfox 是一个用 Go 编写的终端音乐客户端，支持网易云等在线音乐源，
# 界面风格类似网易云 PC 客户端。
#
# 使用：
#   go-musicfox          # 启动
#   配置目录通常位于 ~/.config/go-musicfox
#
# 注意：在线音乐源依赖第三方接口，可能随平台策略变化而失效；
#       本地音乐请使用同目录下的 mpd.nix（mpd + ncmpcpp）。
# ============================================================================

# 模块参数：pkgs —— 包集合；... —— 接受其它未声明的参数
{pkgs, ...}: {
  home.packages = [
    pkgs.go-musicfox # 终端音乐播放器
  ];
}