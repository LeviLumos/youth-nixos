# ============================================================================
# home/youth/terminal/alacritty.nix —— alacritty 终端配置（备选）
# ----------------------------------------------------------------------------
# alacritty 是一个轻量、纯 GPU 的终端模拟器，启动快、配置简单，
# 在此作为 kitty 的备选方案保留。
#
# 与 kitty.nix 的关系：两者同时启用，日常使用哪个可在终端启动器中自选；
#                  系统默认终端仍为 kitty（见 configuration.nix 的 TERMINAL）。
#
# 生成的配置文件位置：~/.config/alacritty/alacritty.toml（由 home-manager 管理）
# ============================================================================
# 形参使用 `_` 表示不需要任何 home-manager 模块参数
_: {
  # ------------------------------------------------------------------------
  # 启用 alacritty
  # ------------------------------------------------------------------------
  programs.alacritty = {
    enable = true; # 安装并注册 alacritty
  };

  # ------------------------------------------------------------------------
  # alacritty 原生设置（对应 alacritty.toml 中的 [font] 段）
  # ------------------------------------------------------------------------
  programs.alacritty.settings = {
    font = {
      normal.family = "FiraCode Nerd Font"; # 正文字体族（含 Nerd 图标）
      normal.style = "Regular"; # 常规字重
      size = 14.0; # 字号
    };
  };

  # ------------------------------------------------------------------------
  # Catppuccin 配色
  # 说明：由 catppuccin/nix 模块直接改写 alacritty.toml 的 colors 段，
  #       与 kitty 使用同一套 Mocha 主题，保证视觉统一。
  # ------------------------------------------------------------------------
  catppuccin.alacritty = {
    enable = true; # 应用 Catppuccin 配色
    flavor = "mocha"; # 配色风格（Mocha 为深色主题）
  };
}
