// =============================================================================
//  waybar 状态栏配置（JSONC，支持注释）
// -----------------------------------------------------------------------------
//  部署：home-manager home.file → ~/.config/waybar/config.jsonc
//  样式：~/.config/waybar/style.css（颜色/字体来自 vars.nix）
//  文档：https://github.com/Alexays/Waybar/wiki
//
//  niri 专用模块：niri/workspaces、niri/window（需要 waybar 编译时带 niri 支持）
//  若日志里出现 unknown module，把这两项删掉即可（不影响其他模块）
// =============================================================================
{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 4,
  "margin": "4px 6px",

  "modules-left": ["niri/workspaces", "niri/window"],
  "modules-center": [],
  "modules-right": ["tray", "bluetooth", "power-profiles-daemon", "pulseaudio", "network", "cpu", "memory", "clock"],

  "niri/workspaces": {
    "format": "{name}",
    "format-window-separator": " "
  },

  "niri/window": {
    "format": "{title}",
    "max-length": 60,
    "rewrite": {
      "(.*) — Mozilla Firefox": "Firefox",
      "(.*) — Chromium": "Chromium"
    }
  },

  "tray": {
    "icon-size": 18,
    "spacing": 8
  },

  "bluetooth": {
    "format": "BT on",
    "format-disconnected": "BT off",
    "format-connected": "BT on",
    "on-click": "blueman-manager",
    "on-click-right": "blueman-manager"
  },

  "power-profiles-daemon": {
    "format": "PWR {profile}",
    "on-click": "powerprofilesctl set performance",
    "on-click-middle": "powerprofilesctl set balanced",
    "on-click-right": "powerprofilesctl set power-saver"
  },

  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "{:%Y-%m-%d %A}"
  },

  "cpu": {
    "format": "CPU {usage}%",
    "interval": 5
  },

  "memory": {
    "format": "MEM {used:0.1GiB}",
    "interval": 5
  },

  "pulseaudio": {
    "format": "VOL {volume}%",
    "format-muted": "VOL muted",
    "on-click": "pavucontrol"
  },

  "network": {
    "format-wifi": "NET {essid}",
    "format-ethernet": "NET wired",
    "format-disconnected": "NET off",
    "interval": 5
  }
}
