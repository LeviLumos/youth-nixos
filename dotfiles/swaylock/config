# =============================================================================
#  swaylock 锁屏样式（super+alt+l；空闲自动锁屏走同一份配置）
# -----------------------------------------------------------------------------
#  部署：modules/home/desktop.nix → ~/.config/swaylock/config
#  占位符：@background@ / @foreground@ / @accent@ / @fontFamily@（构建期替换）
#  ⚠️ 本文件里出现的 @background@ / @foreground@ / @accent@ / @fontFamily@
#     都必须在 desktop.nix 的替换表里（注释里写的也算，会被引擎检查）
#
#  颜色格式：RRGGBB 或 RRGGBBAA（不带 #；desktop.nix 替换时已去掉）
#  截图里那个红色圆圈 = 「密码错误」指示器，下面把它配成了主题色
# =============================================================================

# ---- 背景：桌面同款壁纸 -------------------------------------------------------
image=~/Pictures/wallpaper.jpg
scaling=fill
# 壁纸加载失败时的兜底纯色
color=@background@

# ---- 指示器几何 ---------------------------------------------------------------
indicator-radius=100
indicator-thickness=12
show-failed-attempts

# ---- 常态 ---------------------------------------------------------------------
ring-color=@accent@            # 外环 = 主题强调色
inside-color=@background@      # 圆内 = 背景色
text-color=@foreground@
line-color=@background@

# ---- 按键高亮 ------------------------------------------------------------------
key-hl-color=@accent@          # 每输入一个字符
bs-hl-color=E06C75             # 退格（红）

# ---- Backspace/Clear 态 --------------------------------------------------------
ring-clear-color=@accent@
inside-clear-color=@background@
text-clear-color=@foreground@

# ---- 验证中 ---------------------------------------------------------------------
ring-ver-color=@foreground@
inside-ver-color=@background@
text-ver-color=@foreground@

# ---- 密码错误（原默认 = 灰底大红斑）----------------------------------------------
ring-wrong-color=E06C75
inside-wrong-color=E06C75
text-wrong-color=@background@
line-wrong-color=@background@

separator-color=@background@

# ---- 文本字体（提示文字）--------------------------------------------------------
font=@fontFamily@
font-size=16

# ---- 行为 -----------------------------------------------------------------------
ignore-empty-password
